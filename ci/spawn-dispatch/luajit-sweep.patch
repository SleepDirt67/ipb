+/* The engine opens this window around consecutive M_SPAWN dispatches.
+** Only post-atomic object sweeping may yield. The explicit Lua API and
+** the remainder of the collector retain their own stepping rules. */
+enum { DISPATCH_QUANTA = 8, DISPATCH_MAX_AGE = 120,
+       DISPATCH_MAX_GROWTH = 4 * 1024 * 1024 };
+
+static int dispatch_can_yield(global_State *g)
+{
+  if ((!g->dispatch_sweep.depth && !g->dispatch_sweep.outstanding) ||
+      g->gc.state != GCSsweep ||
+      gcref(g->gc.mmudata) || g->gc.threshold == LJ_MAX_MEM)
+    return 0;
+  if (g->dispatch_sweep.quanta < DISPATCH_QUANTA) {
+    ++g->dispatch_sweep.quanta;
+    return 0;
+  }
+  if (!g->dispatch_sweep.outstanding) {
+    g->dispatch_sweep.outstanding = 1;
+    g->dispatch_sweep.first_total = g->gc.total;
+  }
+  if (g->dispatch_sweep.age >= DISPATCH_MAX_AGE ||
+      (g->gc.total > g->dispatch_sweep.first_total &&
+       g->gc.total - g->dispatch_sweep.first_total >= DISPATCH_MAX_GROWTH))
+    return 0;
+  if (g->dispatch_sweep.depth && g->dispatch_sweep.deferred_calls < 0x7fffffff)
+    ++g->dispatch_sweep.deferred_calls;
+  return 1;
+}
+
+static void dispatch_clear_debt(global_State *g)
+{
+  g->dispatch_sweep.outstanding = 0;
+  g->dispatch_sweep.age = 0;
+}
