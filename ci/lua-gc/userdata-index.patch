+  MSize end = g->gc.udatasweepend;
+  if (!end) end = g->gc.udatalen;
+  while (read < end && limit != 0) {
+    GCobj *o = gcref(list[read++]);
+    int pending = gcref(o->gch.nextgc) != NULL;
