+/* Tables have no finalizers. Sweep their headers directly from a dense
+** index, without serially loading unrelated root nodes. Allocations made
+** after the boundary are current white and need at most pointer compaction.
+*/
+static uint32_t gc_sweeptables(global_State *g, uint32_t limit)
+{
+  GCRef *list = mref(g->gc.tablist, GCRef);
+  int ow = otherwhite(g);
+  MSize read = g->gc.tabsweep, write = g->gc.tabout;
+  MSize end = g->gc.tabsweepend;
+  while (read < end && limit != 0) {
+    GCobj *o = gcref(list[read]);
+    if (end - read > 8) {
+#if defined(_MSC_VER) && LJ_TARGET_X64
+      _mm_prefetch((const char *)gcref(list[read + 8]), _MM_HINT_T0);
+#elif defined(__GNUC__) || defined(__clang__)
+      __builtin_prefetch(gcref(list[read + 8]), 1, 3);
+#endif
+    }
+    ++read;
+    --limit;
+    if (((o->gch.marked ^ LJ_GC_WHITES) & ow)) {
+      makewhite(g, o);
+      if (write != read - 1) setgcref(list[write], o);
+      ++write;
+    } else {
+      lj_tab_free(g, gco2tab(o));
+    }
+  }
+  if (read >= end) {
+    if (write != read) {
+      MSize count = g->gc.tablen - read;
+      if (count > limit) count = limit;
+      if (count) {
+        memmove(list + write, list + read, count * sizeof(GCRef));
+        read += count;
+        write += count;
+        limit -= count;
+      }
+    } else {
+      read = write = g->gc.tablen;
+    }
+    if (read == g->gc.tablen) {
+      g->gc.tablen = write;
+      g->gc.tabsweep = g->gc.tabout = 0;
+      g->gc.tabsweepend = ~(MSize)0;
+      return limit;
+    }
+  }
+  g->gc.tabsweep = read;
+  g->gc.tabout = write;
+  g->gc.tabsweepend = end;
+  return limit;
+}
