+GCtab * LJ_FASTCALL lj_mem_newgctab(lua_State *L, GCSize size)
+{
+  global_State *g = G(L);
+  GCRef *list = mref(g->gc.tablist, GCRef);
+  MSize index = g->gc.tablen;
+  GCobj *o;
+  if (index == g->gc.tabcap) {
+    list = (GCRef *)lj_mem_grow(L, list, &g->gc.tabcap,
+                              LJ_MAX_MEM32 / sizeof(GCRef), sizeof(GCRef));
+    setmref(g->gc.tablist, list);
+  }
+  o = (GCobj *)lj_mem_realloc(L, NULL, 0, size);
+  newwhite(g, o);
+  setgcrefnull(o->gch.nextgc);
+  setgcref(list[index], o);
+  g->gc.tablen = index + 1;
+  return &o->tab;
+}
