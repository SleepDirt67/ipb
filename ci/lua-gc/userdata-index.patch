+/* Queue one full userdata, preserving the original newest-first order. */
+static size_t gc_separateudata(global_State *g, GCobj *o)
+{
+  if (isfinalized(gco2ud(o))) return 0;
+  markfinalized(o);
+  if (!lj_meta_fastg(g, tabref(gco2ud(o)->metatable), MM_gc))
+    return 0;
+  if (gcref(g->gc.mmudata)) {
+    GCobj *root = gcref(g->gc.mmudata);
+    setgcrefr(o->gch.nextgc, root->gch.nextgc);
+    setgcref(root->gch.nextgc, o);
+  } else {
+    setgcref(o->gch.nextgc, o);
+  }
+  setgcref(g->gc.mmudata, o);
+  return sizeudata(gco2ud(o));
+}
