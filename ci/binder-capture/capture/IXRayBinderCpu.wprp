<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="IX-Ray">
  <Profiles>
    <SystemCollector Id="BinderCollector" Name="IXRayBinderKernel">
      <BufferSize Value="512" />
      <Buffers Value="256" />
    </SystemCollector>
    <SystemProvider Id="BinderProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
      </Keywords>
      <Stacks><Stack Value="SampledProfile" /></Stacks>
    </SystemProvider>
    <Profile Id="IXRayBinderCpu.Verbose.File" Name="IXRayBinderCpu" Description="IX-Ray binder CPU samples and thread scheduling" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="BinderCollector"><SystemProviderId Value="BinderProvider" /></SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
