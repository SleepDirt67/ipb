+        ModelLoadDiagnostic() : active(FrameStallDiag::Enabled())
+        {
+            if (active && modelLoadDepth++ == 0)
+            {
+                frame = FrameStallDiag::CurrentFrame();
+                start = std::chrono::steady_clock::now();
+            }
+        }
+        ~ModelLoadDiagnostic()
+        {
+            if (!active) return;
+            if (--modelLoadDepth == 0 && frame)
+            {
+                const auto us = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - start).count();
+                FrameStallDiag::Record(FrameStallDiag::Stage::ModelLoadOuter, frame, us > 0 ? static_cast<unsigned long long>(us) : 0);
+            }
+        }
+    };
+}
 
