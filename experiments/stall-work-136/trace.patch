+        explicit DetailScope(Stage stage, const char* name = nullptr)
+            : stage_(stage), active_(Enabled()), frame_(active_ ? CurrentFrame() : 0),
+              start_(active_ ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{}),
+              cycles_(active_ ? ThreadCycles() : 0)
+        {
+            if (active_ && name) strncpy_s(name_, sizeof(name_), name, _TRUNCATE);
+        }
+        ~DetailScope()
+        {
+            if (!active_ || frame_ == 0) return;
+            const auto cycles = ThreadCycles();
+            const auto us = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - start_).count();
+            Record(stage_, frame_, us > 0 ? static_cast<unsigned long long>(us) : 0);
+            RecordCycles(stage_, frame_, cycles >= cycles_ ? cycles - cycles_ : 0);
+            if (name_[0]) RecordWorst(stage_, frame_, us > 0 ? static_cast<unsigned long long>(us) : 0, name_);
